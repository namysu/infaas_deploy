# INFaaS on docker — deployment settings (docs/DOCKER.md).
# Read by deploy/docker/gen_compose.py, which writes generated/docker-compose.yml.
# One KEY=VALUE per line; comments on their own lines only.

# ===================================================================== GPUs
# Which GPUs become workers (one worker container per GPU), by nvidia-smi index:
#   GPUS=0:a30,1:a30,2:a5000,3:a5000      index:gpu_type, comma-separated
#   GPUS=GPU-8589f65b-...:a30,...          an nvidia-smi UUID works in place of the index
#   GPUS=auto                              every GPU nvidia-smi lists; type from its name
#                                          ("NVIDIA A30" -> a30, "NVIDIA GeForce RTX 2080 Ti" -> 2080ti)
# A subset is fine (e.g. GPUS=0:a30,2:a30 leaves GPUs 1 and 3 alone).
# `deploy/docker/infaas-docker.sh gpus` prints the indices and a suggested line.
GPUS=auto

# GPU types in increasing cost order and their relative price (cost model, PLAN C9).
# Every type used in GPUS needs a price. HW_TYPES empty = the types in GPUS, by price.
# Only one GPU type on the host -> no model-vertical scaling (variants differ by GPU type).
HW_TYPES=
HW_COST=2080ti:1,a5000:2,a30:4

# Preprocessing per GPU type, as in Lumina: GPUs with the NVJPG engine (A30, L40S)
# use gpu_only, all others cpu_decode_gpu.
PREPROCESS_MODES=a30:gpu_only,l40s:gpu_only

# Optional CPU pinning per GPU index, e.g. 0:0-7,1:8-15,2:16-23,3:24-31 (empty = none)
CPUSETS=

# ===================================================================== host paths
# HuggingFace cache with the model weights (HF_HOME of the workers; `infaas-docker.sh download`)
MODEL_DIR=/data/podexec-models
# variant profiles (persist across controller restarts)
PROFILE_DIR=/data/infaas-profiles
# request/event JSON-lines logs
LOG_DIR=/data/infaas-logs

# ===================================================================== images
CONTROLLER_IMAGE=infaas-controller:0.1.0
WORKER_IMAGE=infaas-worker:0.1.0

# ===================================================================== network
# bridge: one docker network; workers reached by container name (single host)
# host  : host networking; worker i listens on WORKER_BASE_PORT + i. Use this when
#         workers on other hosts take part (ROLE / EXTRA_WORKERS below).
NETWORK=bridge
# bridge: host address the controller ports (50052 native, 50053 registrar, 8081 Lumina API) bind to
PUBLISH_ADDR=0.0.0.0
# bridge: published host port = default + offset (50052, 50053, 8081; redis 16379 on 127.0.0.1).
# Set e.g. 10000 when those ports are taken on the host (-> 60052, 60053, 18081).
HOST_PORT_OFFSET=0
WORKER_BASE_PORT=9000

# --- more than one host (optional; NETWORK=host) ---
# all       : redis + controller + vm-autoscaler + this host's GPU workers
# controller: redis + controller + vm-autoscaler only
# workers   : this host's GPU workers only, joining the controller at CONTROLLER_HOST
ROLE=all
CONTROLLER_HOST=
# address other hosts use to reach this host's workers (ROLE=workers prints the line to copy)
ADVERTISE_HOST=127.0.0.1
# workers on other hosts, "name=gpu_type@host:port,..." (on the controller host)
EXTRA_WORKERS=

# ===================================================================== INFaaS policy
# Same keys as k8s/configmap.yaml; defaults and sources in infaas/common/config.py.
DECISION_MODE=6
AUTOSCALER_TYPE=infaas
LAMBDA=1.0
SLACK_THRESHOLD=1.05
VM_UTIL_THRESHOLD=80
MONITOR_INTERVAL_S=2.0
MODEL_AUTOSCALER_INTERVAL_S=1.0
VM_AUTOSCALER_INTERVAL_S=2.0
EXEC_BLACKLIST_UTIL_ENABLED=false
EXEC_BLACKLIST_QPS_ENABLED=false
# original: as the released INFaaS — forward pass on a random tensor of the model's input
#           size, no image needed at registration; preprocessing is not part of the latency
# service : the worker's whole request path on a given JPEG (decode + preprocess included)
PROFILE_MODE=original
PROFILE_RUNS=30
PROFILE_SAT_SECONDS=5
PROFILE_SAT_CONCURRENCY=4
REQUEST_LOG=/logs/requests.jsonl
EVENT_LOG=/logs/events.jsonl
